DC_DB_HOST=127.0.0.1
DC_DB_PORT=15432
DC_DB_NAME=dreamcatch
DC_DB_USER=dc_app
DC_DB_PASSWORD_FILE=/absolute/path/to/private/password-file
DC_ENVIRONMENT=development
DC_DEVELOPMENT_IDENTITY=true
# Enable only after configuring a model supporting strict JSON-schema Chat Completions.
DC_ROADMAP_PROVIDER=disabled
DC_ROADMAP_API_URL=https://api.openai.com/v1/chat/completions
DC_ROADMAP_MODEL=
DC_ROADMAP_API_KEY_FILE=
DC_ROADMAP_TIMEOUT_SECONDS=45
