server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        # Resolve again after an API container is recreated.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-DC-Token "${DC_PROXY_TOKEN}";
        proxy_read_timeout 75s;
    }

    location /assets/ { try_files $uri =404; }
    location = /v2 { try_files /v2.html =404; }
    location /v2/ { try_files $uri /v2.html; }
    location = /admin { try_files /admin.html =404; }
    location /admin/ { try_files $uri /admin.html; }
    location / { try_files $uri $uri/ /index.html; }
}
