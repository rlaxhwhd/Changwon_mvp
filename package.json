{
  "name": "changwon-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "docker:bootstrap": "node scripts/bootstrap-local.mjs",
    "docker:up": "node scripts/local-stack.mjs up",
    "docker:migrate": "node scripts/local-stack.mjs migrate",
    "docker:down": "node scripts/local-stack.mjs down",
    "docker:logs": "node scripts/local-stack.mjs logs",
    "docker:ps": "node scripts/local-stack.mjs ps",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "rtk": ".\\.tools\\rtk\\rtk.exe",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:db": "docker start dreamcatch-dev-db",
    "dev:api": "npm run dev:db && cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 18100"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.16",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.3.1"
  }
}
